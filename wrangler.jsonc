{
	"name": "uniquedonut",
	"main": ".open-next/worker.js",
	"compatibility_date": "2024-12-30",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Quiz leaderboard storage (Cloudflare D1).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "uniquedonut-db",
			"database_id": "a163b893-7298-41fc-bc5f-5b2fbc5ab6cb"
		}
	],
	// Custom domain — Cloudflare가 DNS 레코드와 인증서를 자동 프로비저닝한다.
	// workers_dev=true 로 기존 *.workers.dev 주소도 함께 유지 (racknerd cron·기존 에이전트 호환).
	"workers_dev": true,
	"routes": [
		{ "pattern": "uniquedonut.com", "custom_domain": true }
	]
}
