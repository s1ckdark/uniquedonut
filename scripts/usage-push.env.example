# usage-push.env.example — racknerd 에서 usage-push.env 로 복사하고 실제 값 채우기
#chmod 600 usage-push.env  로 보호할 것. 이 예시 파일에는 실제 값을 넣지 않는다.

# Cloudflare Worker 가 검증하는 푸시 시크릿 (wrangler secret 으로 등록한 것과 동일한 값)
USAGE_PUSH_SECRET=

# Postgres 접근 경로 — 도커 컨테이너면 기본값 그대로, 호스트 psql 이면 아래 주석 참고
#PSQL_CMD=docker exec postgres psql -U postgres -d postgres
#PSQL_CMD=psql -h 127.0.0.1 -U postgres -d postgres

# 수신 API (기본값: Token Board 프로덕션)
#API_URL=https://uniquedonut.s1ckdark.workers.dev/api/usage
